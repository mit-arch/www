---
layout: layouts/base.njk
title: Seminar
description: Current architecture seminar term
---
{% from "components/seminar-list.njk" import schedule %}

<section class="page-head wrap">
  <p class="page-eyebrow">Seminar</p>
  <h1 class="page-title">{{ currentSeminar.label }}</h1>
  {# The standing slot is the thing a reader most needs: when and where. #}
  {% if currentSeminar.description %}
    <p class="schedule-meta"><span>{{ currentSeminar.description }}</span></p>
  {% endif %}
  <p class="page-intro">{{ site.seminarBlurb }}</p>
</section>

<div class="wrap">
  {% if currentSeminar.talks.length %}
    {{ schedule(currentSeminar) }}
  {% else %}
    <p class="schedule-none">No talks have been posted for this term yet.</p>
  {% endif %}

  <p class="link-row">
    <a href="{{ '/seminar/all.ics' | siteUrl }}">Subscribe to calendar</a>
    <a href="{{ '/seminar/archive/' | siteUrl }}">Browse past terms</a>
  </p>
</div>
