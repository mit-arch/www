---
pagination:
  data: seminarTerms
  size: 1
  alias: term
permalink: "seminar/{{ term.slug }}/index.html"
layout: layouts/base.njk
eleventyExcludeFromCollections: true
---
{% from "components/seminar-list.njk" import schedule %}

<section class="page-head wrap">
  <p class="page-eyebrow">Seminar</p>
  <h1 class="page-title">{{ term.label }}</h1>
  {% if term.description %}
    <p class="schedule-meta"><span>{{ term.description }}</span></p>
  {% endif %}
  <p class="page-intro">{{ site.seminarBlurb }}</p>
</section>

<div class="wrap">
  {% if term.talks.length %}
    {{ schedule(term) }}
  {% else %}
    <p class="schedule-none">No talks are listed for this term.</p>
  {% endif %}

  <p class="link-row">
    <a href="{{ '/seminar/all.ics' | siteUrl }}">Subscribe to calendar</a>
    <a href="{{ '/seminar/archive/' | siteUrl }}">Back to archive</a>
  </p>
</div>
