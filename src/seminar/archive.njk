---
layout: layouts/base.njk
title: Seminar Archive
description: Archived seminar terms
---
<section class="page-head wrap">
  <p class="page-eyebrow">Seminar</p>
  <h1 class="page-title">Archive</h1>
  <p class="page-intro">Past terms remain available as stand-alone schedule pages.</p>
</section>

{# Ruled rows rather than cards. The old .archive-card inherited uppercase and
   letter-spacing from a shared micro-text rule, which set each term's whole
   description sentence in 12px capitals. #}
<div class="wrap">
  <div class="record-list">
    {% for term in seminarTerms %}
      {% if term.slug != currentSeminar.slug %}
        <article class="record">
          <div class="record-meta">
            <span>{{ term.talks.length }} talk{% if term.talks.length != 1 %}s{% endif %}</span>
          </div>
          <div class="record-copy">
            <p class="record-title">
              <a href="{{ ('/seminar/' + term.slug + '/') | siteUrl }}">{{ term.label }}</a>
            </p>
            {% if term.description %}<p>{{ term.description }}</p>{% endif %}
          </div>
        </article>
      {% endif %}
    {% endfor %}
  </div>

  <p class="link-row">
    <a href="{{ '/seminar/' | siteUrl }}">Current term</a>
    <a href="{{ '/seminar/all.ics' | siteUrl }}">Subscribe to calendar</a>
  </p>
</div>
