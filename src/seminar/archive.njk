---
layout: layouts/base.njk
title: Seminar Archive
description: Archived seminar terms
---
<section class="page-head wrap">
  <p class="page-eyebrow">Seminar</p>
  <h1 class="page-title">Archive</h1>
  <p class="page-intro">Previous Architecture Seminars</p>
</section>

{# Nothing but the terms. The talk count and the standing slot (`schedule_note`,
   the "Fridays · 1:00 PM · 34-401" line) both belong on the term page itself —
   here they were metadata about a link, which is not something anyone reads
   before clicking it. Newest term first, per the seminarTerms sort. #}
<div class="wrap section-body">
  {# role="list" restores the semantics Safari drops when list-style is none. #}
  <ul class="term-list" role="list">
    {% for term in seminarTerms %}
      {% if term.slug != currentSeminar.slug %}
        <li><a href="{{ ('/seminar/' + term.slug + '/') | siteUrl }}">{{ term.label }}</a></li>
      {% endif %}
    {% endfor %}
  </ul>
</div>
