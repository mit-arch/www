---
layout: layouts/base.njk
title: Home
description: MIT Architecture Research group homepage
---
{% from "components/person-card.njk" import personCard %}
{% from "components/news-item.njk" import newsRow %}
{% from "components/machine-timeline.njk" import machineAxis %}

<section class="hero wrap">
  <p class="hero-eyebrow">{{ site.hero.eyebrow }}</p>
  <h1 class="hero-title">{{ site.hero.title }}</h1>
  <p class="hero-body">{{ site.hero.body }}</p>
  {{ machineAxis(machines) }}
</section>

{# News sits directly under the hero at every width. It used to be a sticky
   right rail that, once the grid collapsed, landed below all 45 people. #}
<section class="section" id="news">
  <h2 class="band">
    <span class="wrap band-inner">
      <span class="band-title">News</span>
      <a class="band-link" href="{{ '/news/' | siteUrl }}">All news</a>
    </span>
  </h2>
  <div class="wrap section-body">
    <div class="news-strip">
      {% for item in collections.newsItems %}
        {% if loop.index <= site.newsHomepageCount %}
          {{ newsRow(item) }}
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<section class="section" id="faculty">
  <h2 class="band">
    <span class="wrap band-inner">
      <span class="band-title">Faculty</span>
      <span class="band-count">{{ people.faculty.length }}</span>
    </span>
  </h2>
  <div class="wrap section-body">
    <div class="people-grid">
      {% for person in people.faculty %}{{ personCard(person) }}{% endfor %}
    </div>
  </div>
</section>

<section class="section" id="affiliates">
  <h2 class="band">
    <span class="wrap band-inner">
      <span class="band-title">Affiliates</span>
      <span class="band-count">{{ people.affiliates.length }}</span>
    </span>
  </h2>
  <div class="wrap section-body">
    <div class="people-grid">
      {% for person in people.affiliates %}{{ personCard(person) }}{% endfor %}
    </div>
  </div>
</section>

{# Names only: each student's advisor lives in their `program` field and is
   deliberately not rendered here. #}
<section class="section" id="students">
  <h2 class="band">
    <span class="wrap band-inner">
      <span class="band-title">PhD Students</span>
      <span class="band-count">{{ people.students.length }}</span>
    </span>
  </h2>
  <div class="wrap section-body">
    <div class="people-grid">
      {% for person in people.students %}{{ personCard(person, false) }}{% endfor %}
    </div>
  </div>
</section>

<section class="section" id="alumni">
  <h2 class="band">
    <span class="wrap band-inner">
      <span class="band-title">Alumni</span>
      <span class="band-count">{{ people.alumni.length }}</span>
    </span>
  </h2>
  <div class="wrap section-body">
    <div class="record-list">
      {% for person in people.alumni %}
        <article class="record">
          <div class="record-meta">
            <span>{{ person.graduation_year }}</span>
          </div>
          <div class="record-copy">
            <p class="record-title">
              {% if person.website %}
                <a href="{{ person.website }}"{% if person.website | isExternalUrl %} target="_blank" rel="noreferrer"{% endif %}>{{ person.name }}</a>
              {% else %}
                {{ person.name }}
              {% endif %}
            </p>
            {% if person.current_job %}<p>{{ person.current_job }}</p>{% endif %}
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>
