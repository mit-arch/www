---
layout: layouts/base.njk
title: Home
description: MIT Architecture Research group homepage
---
{% from "components/person-card.njk" import personCard %}
{% from "components/news-item.njk" import newsLedger %}

{# Hero and news share one band. The hero comes first in the DOM so that it
   opens the page for readers, for the keyboard, and on phones; on desktop the
   grid places the news rail into the left column beside it. #}
<section class="hero-split wrap">
  <div class="hero-main">
    <h1 class="hero-title">{{ site.hero.title }}</h1>
    <p class="hero-body">{{ site.hero.body }}</p>
  </div>

  <div class="hero-rail" id="news">
    <h2 class="rail-title">News</h2>
    {# Same ledger as /news/, truncated to the most recent few. #}
    {{ newsLedger(collections.newsItems.slice(0, site.newsHomepageCount), "Recent news") }}
    {# The link sits after the items it continues. #}
    <p class="more-link"><a href="{{ '/news/' | siteUrl }}">All news</a></p>
  </div>
</section>

<section class="section" id="faculty">
  <h2 class="band">
    <span class="wrap band-inner">
      <span class="band-title">Faculty</span>
    </span>
  </h2>
  <div class="wrap section-body">
    <div class="people-grid people-grid--lg">
      {% for person in people.faculty %}{{ personCard(person) }}{% endfor %}
    </div>
  </div>
</section>

<section class="section" id="affiliates">
  <h2 class="band">
    <span class="wrap band-inner">
      <span class="band-title">Affiliates</span>
    </span>
  </h2>
  <div class="wrap section-body">
    <div class="people-grid people-grid--lg">
      {% for person in people.affiliates %}{{ personCard(person) }}{% endfor %}
    </div>
  </div>
</section>

{# Names only: each student's advisor lives in their `program` field and is
   deliberately not rendered here. #}
<section class="section" id="students">
  <h2 class="band">
    <span class="wrap band-inner">
      <span class="band-title">PhD Students</span>
    </span>
  </h2>
  <div class="wrap section-body">
    <div class="people-grid">
      {% for person in people.students %}{{ personCard(person, false) }}{% endfor %}
    </div>
  </div>
</section>

<section class="section" id="alumni">
  <h2 class="band">
    <span class="wrap band-inner">
      <span class="band-title">Alumni</span>
    </span>
  </h2>
  <div class="wrap section-body">
    <div class="alumni-list">
      {% for person in people.alumni %}
        <p class="alumni-row">
          <span class="alumni-year">{{ person.graduation_year }}</span>
          <span class="alumni-name">
            {% if person.website %}
              <a href="{{ person.website }}"{% if person.website | isExternalUrl %} target="_blank" rel="noreferrer"{% endif %}>{{ person.name }}</a>
            {% else %}
              {{ person.name }}
            {% endif %}
          </span>
          {% if person.current_job %}<span class="alumni-job">{{ person.current_job }}</span>{% endif %}
        </p>
      {% endfor %}
    </div>
  </div>
</section>
