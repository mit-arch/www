{# newsRow(item) — the shared record primitive: mono meta gutter, then copy.
   `date` comes off the collection item, `kind` off its front matter. #}
{% macro newsRow(item) %}
  <article class="record">
    <div class="record-meta">
      <time datetime="{{ item.date | isoDate }}">{{ item.date | readableDate }}</time>
      {% if item.data.kind %}<span class="tag">{{ item.data.kind }}</span>{% endif %}
    </div>
    <div class="record-copy">
      {{ item.content | safe }}
    </div>
  </article>
{% endmacro %}
