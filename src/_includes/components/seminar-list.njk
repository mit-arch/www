{# schedule(term) — the seminar schedule is tabular data, so it is a table.
   Below 760px the CSS hides the header row and each <tr> reflows to a block
   whose cells carry their own labels via data-label. #}
{% macro schedule(term) %}
  <table class="data-table schedule">
    <caption class="visually-hidden">{{ term.label }} seminar schedule</caption>
    <thead>
      <tr>
        <th scope="col">Date</th>
        <th scope="col">Speaker</th>
        <th scope="col">Talk</th>
        <th scope="col">Where</th>
      </tr>
    </thead>
    <tbody>
      {% for talk in term.talks %}
        <tr{% if talk.cancelled %} class="is-cancelled"{% endif %}>
          <td class="schedule-date"><time datetime="{{ talk.date | isoDate }}">{{ talk.date | seminarDate }}</time></td>
          {% if talk.cancelled %}
            {# No speaker, no room: one muted cell across the rest of the row. #}
            <td class="schedule-none" colspan="3">
              <span class="schedule-flag">No seminar</span>{{ talk.title }}
            </td>
          {% else %}
            <td class="schedule-speaker" data-label="Speaker">
              {{ talk.speaker }}
              {% if talk.affiliation %}<span class="schedule-affiliation">{{ talk.affiliation }}</span>{% endif %}
            </td>
            <td class="schedule-talk">
              <span class="schedule-title">{{ talk.title }}</span>
              {% if talk.abstract %}<p class="schedule-abstract">{{ talk.abstract }}</p>{% endif %}
              {% if talk.link %}
                <p class="schedule-links">
                  <a href="{{ talk.link }}"{% if talk.link | isExternalUrl %} target="_blank" rel="noreferrer"{% endif %}>Talk details</a>
                </p>
              {% endif %}
            </td>
            <td class="schedule-where" data-label="Where">
              {% if talk.location %}<span class="schedule-room">{{ talk.location }}</span>{% endif %}
              {% if talk.time %}{{ talk.time }}{% endif %}
              {% if talk.format %}<span class="schedule-host">{{ talk.format }}</span>{% endif %}
              {% if talk.host %}<span class="schedule-host">Host: {{ talk.host }}</span>{% endif %}
            </td>
          {% endif %}
        </tr>
      {% endfor %}
    </tbody>
  </table>
{% endmacro %}
