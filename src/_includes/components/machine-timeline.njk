{# machineAxis(machines) — the homepage signature element.

   No JavaScript by design. Detail is revealed with :hover and :focus-within,
   so it works from the keyboard, survives a failed script, and keeps every
   blurb in the accessibility tree at all times. Below 760px the axis becomes a
   vertical list with all detail already visible, because hover does not exist
   there.

   Each tick links to the primary source for that machine — see
   src/_data/machines/timeline.yaml, where `source` is a required field. #}
{% macro machineAxis(machines) %}
  <section class="machines" aria-labelledby="machines-label">
    <h2 class="machines-label" id="machines-label">Selected machines — each links to its source</h2>
    <ol class="machine-axis">
      {% for machine in machines %}
        <li class="machine">
          <a class="machine-tick" href="{{ machine.source }}"{% if machine.source | isExternalUrl %} target="_blank" rel="noreferrer"{% endif %}>
            <span class="machine-year">{{ machine.year }}</span>
            <span class="machine-name">{{ machine.name }}</span>
          </a>
          <div class="machine-detail">
            <p class="machine-people">{{ machine.people }}{% if machine.venue %} &middot; {{ machine.venue }}{% endif %}</p>
            <p class="machine-blurb">{{ machine.blurb }}</p>
          </div>
        </li>
      {% endfor %}
    </ol>
    {# Holds open the area the detail blocks overlay, so revealing one never
       shifts the page. Hidden on narrow screens where detail is inline. #}
    <div class="machines-reserve" aria-hidden="true"></div>
  </section>
{% endmacro %}
